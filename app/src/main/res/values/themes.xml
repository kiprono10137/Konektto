<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Konektto"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/konektto_primary_light</item>
        <item name="colorOnPrimary">@color/konektto_on_primary_light</item>
        <item name="colorPrimaryContainer">@color/konektto_primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/konektto_on_primary_container_light</item>

        <item name="colorSecondary">@color/konektto_secondary_light</item>
        <item name="colorOnSecondary">@color/konektto_on_secondary_light</item>
        <item name="colorSecondaryContainer">@color/konektto_secondary_container_light</item>
        <item name="colorOnSecondaryContainer">@color/konektto_on_secondary_container_light</item>

        <item name="colorTertiary">@color/konektto_tertiary_light</item>
        <item name="colorOnTertiary">@color/konektto_on_tertiary_light</item>
        <item name="colorTertiaryContainer">@color/konektto_tertiary_container_light</item>
        <item name="colorOnTertiaryContainer">@color/konektto_on_tertiary_container_light</item>

        <item name="android:colorBackground">@color/konektto_background_light</item>
        <item name="colorOnBackground">@color/konektto_on_background_light</item>
        <item name="colorSurface">@color/konektto_surface_light</item>
        <item name="colorOnSurface">@color/konektto_on_surface_light</item>
        <item name="colorSurfaceVariant">@color/konektto_surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/konektto_on_surface_variant_light</item>
        <item name="colorOutline">@color/konektto_outline_light</item>

        <item name="colorError">@color/konektto_error_light</item>
        <item name="colorOnError">@color/konektto_on_error_light</item>

        <item name="android:statusBarColor">@color/konektto_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@style/Konektto.WindowAnimation</item>

        <!-- Bolder, more generous rounded corners app-wide: every
             MaterialButton and MaterialCardView that doesn't set its own
             per-instance shape picks this up automatically. This one
             change is what gives the whole app a distinct, less
             "default Material" feel without touching every layout file. -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Konektto.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Konektto.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Konektto.LargeComponent</item>

    </style>

    <!-- App-wide activity transition animations (slide + fade) -->
    <style name="Konektto.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Global shape system: small = chips/small buttons, medium = standard
         buttons/text fields, large = cards/sheets/dialogs. All three
         explicitly declare parent="": shape appearance styles don't need
         a real parent, and leaving it implicit is exactly what caused a
         real build failure earlier in this project (Android infers a
         parent by stripping the last dot-segment off the name, then fails
         to link when that inferred parent doesn't actually exist). -->
    <style name="ShapeAppearance.Konektto.SmallComponent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.Konektto.MediumComponent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.Konektto.LargeComponent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Reusable circular shape for avatar images across the app -->
    <style name="ShapeAppearanceOverlay.Konektto.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Rounded corners for chat media attachments (images/gifs) -->
    <style name="ShapeAppearanceOverlay.Konektto.RoundedMedia" parent="">
        <item name="cornerSize">12dp</item>
    </style>

</resources>