<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (dark mode). -->
    <style name="Theme.Konektto" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/konektto_primary_dark</item>
        <item name="colorOnPrimary">@color/konektto_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/konektto_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/konektto_on_primary_container_dark</item>

        <item name="colorSecondary">@color/konektto_secondary_dark</item>
        <item name="colorOnSecondary">@color/konektto_on_secondary_dark</item>
        <item name="colorSecondaryContainer">@color/konektto_secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/konektto_on_secondary_container_dark</item>

        <item name="colorTertiary">@color/konektto_tertiary_dark</item>
        <item name="colorOnTertiary">@color/konektto_on_tertiary_dark</item>
        <item name="colorTertiaryContainer">@color/konektto_tertiary_container_dark</item>
        <item name="colorOnTertiaryContainer">@color/konektto_on_tertiary_container_dark</item>

        <item name="android:colorBackground">@color/konektto_background_dark</item>
        <item name="colorOnBackground">@color/konektto_on_background_dark</item>
        <item name="colorSurface">@color/konektto_surface_dark</item>
        <item name="colorOnSurface">@color/konektto_on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/konektto_surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/konektto_on_surface_variant_dark</item>
        <item name="colorOutline">@color/konektto_outline_dark</item>

        <item name="colorError">@color/konektto_error_dark</item>
        <item name="colorOnError">@color/konektto_on_error_dark</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/konektto_surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@style/Konektto.WindowAnimation</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Konektto.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Konektto.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Konektto.LargeComponent</item>

    </style>

</resources>