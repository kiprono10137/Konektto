<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurfaceVariant"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Konektto.Circle"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp"/>

            <Button
                android:id="@+id/btnChangePhoto"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="8dp"
                android:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="17dp"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/white"
                app:iconPadding="0dp"
                app:iconGravity="textStart"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:text="Username"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="email@example.com"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"/>

        <!-- The one place the brand accent gets to stand out on this whole
             screen : everything else stays quiet and lets the content and
             typography do the work. -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="24dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="Edit Profile"
            android:textColor="@color/white"
            android:textStyle="bold"/>

        <!-- Flat, hairline-bordered list : no shadow, no competing
             decoration, just clear rows with real icons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical"
            android:background="?attr/colorSurface">

            <Button
                android:id="@+id/btnMyRooms"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="My Communities"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:icon="@drawable/ic_people"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:iconGravity="textStart"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutline"/>

            <Button
                android:id="@+id/btnFriendRequests"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Friend Requests"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:icon="@drawable/ic_people"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:iconGravity="textStart"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutline"/>

            <Button
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Settings"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:icon="@drawable/ic_settings"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:iconGravity="textStart"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutline"/>

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Log Out"
                android:textColor="?attr/colorError"
                android:textSize="16sp"
                app:icon="@drawable/ic_logout"
                app:iconTint="?attr/colorError"
                app:iconGravity="textStart"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
