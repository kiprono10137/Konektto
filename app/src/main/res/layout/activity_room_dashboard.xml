<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#2563EB">

        <TextView
            android:id="@+id/tvRoomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Football Fans"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:id="@+id/tvCreator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Created by Kip"
            android:textColor="#DCE7FF"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⚽ Football"
            android:textColor="#DCE7FF"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="👥 1 Member"
            android:textColor="#DCE7FF"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- ANNOUNCEMENT -->

    <TextView
        android:id="@+id/tvAnnouncement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#FFF3CD"
        android:padding="14dp"
        android:text="📢 Announcement"
        android:textColor="#000000"
        android:textStyle="bold"
        android:visibility="gone"/>

    <!-- BUTTONS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btnAdminPanel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="👑 Admin Panel"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnViewMembers"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="👥 View Members"/>

        <Button
            android:id="@+id/btnLeaveRoom"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#EF4444"
            android:text="🚪 Leave Community"
            android:textColor="@android:color/white"/>

    </LinearLayout>

    <!-- CHAT -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- MESSAGE BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@android:color/white">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:hint="Message the community..."
            android:textColor="@android:color/black"
            android:textColorHint="#808080"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="16dp"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:text="➜"
            android:textSize="18sp"/>

    </LinearLayout>

</LinearLayout>