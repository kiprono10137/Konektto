<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="?attr/colorPrimary">

        <TextView
            android:id="@+id/tvRoomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Football Fans"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"/>

        <TextView
            android:id="@+id/tvCreator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Created by Kip"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⚽ Football"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="👥 1 Member"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- ANNOUNCEMENT -->

    <TextView
        android:id="@+id/tvAnnouncement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="?attr/colorTertiaryContainer"
        android:padding="14dp"
        android:text="📢 Announcement"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:textStyle="bold"
        android:visibility="gone"/>

    <!-- BUTTONS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btnAdminPanel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="👑 Admin Panel"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnViewMembers"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="👥 View Members"/>

        <Button
            android:id="@+id/btnLeaveRoom"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="?attr/colorError"
            android:text="🚪 Leave Community"
            android:textColor="?attr/colorOnError"/>

    </LinearLayout>

    <!-- CHAT -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- MESSAGE BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="?attr/colorSurface">

        <Button
            android:id="@+id/btnAttach"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="📎"
            android:textSize="18sp"/>

        <com.example.konektto.konektto.widgets.GifSupportEditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Message the community..."
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="16dp"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:text="➜"
            android:textSize="18sp"/>

    </LinearLayout>

</LinearLayout>