<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>


    <application
        android:name=".konektto.KonecttoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Konektto">

        <activity

            android:name="com.example.konektto.konektto.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Konektto"
            android:label="">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <activity android:name="com.example.konektto.konektto.activities.MainActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.LoginActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.RegisterActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.CreateRoomActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.ChatActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.ProfileActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.RoomDashboardActivity"/>
        <activity android:name=".konektto.activities.MembersActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.UserProfileActivity"/>

        <!-- Add this -->
        <activity android:name="com.example.konektto.konektto.activities.EditProfileActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.MyRoomsActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.SettingsActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.CommunityAdminActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.EditCommunityActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.AnnouncementActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.PrivateChatActivity"/>
        <activity android:name="com.example.konektto.konektto.activities.FriendRequestsActivity"/>

        <activity android:name="com.example.konektto.konektto.activities.JoinByCodeActivity"/>

        <activity
            android:name="com.example.konektto.konektto.activities.DeepLinkActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="konektto" android:host="join"/>
            </intent-filter>
        </activity>

        <service
            android:name="com.example.konektto.konektto.services.KonecttoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>





    </application>

</manifest>